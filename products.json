<!DOCTYPE html>
<html lang="si">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Mahesh Market - Online Store</title>

<style>
*{box-sizing:border-box}
body{
  margin:0;
  font-family:Arial,sans-serif;
  background:#f5f6fa;
  color:#222
}
header{
  background:#111827;
  color:white;
  padding:18px 15px;
  text-align:center
}
header h1{margin:0;font-size:28px}
header p{margin:7px 0 0;color:#d1d5db}

.search{
  padding:15px;
  background:white;
  position:sticky;
  top:0;
  z-index:10
}
.search input{
  width:100%;
  padding:14px;
  border:1px solid #ddd;
  border-radius:10px;
  font-size:16px
}

.categories{
  display:flex;
  gap:8px;
  overflow-x:auto;
  padding:12px
}
.categories button{
  border:0;
  background:#e5e7eb;
  padding:10px 16px;
  border-radius:20px;
  white-space:nowrap;
  cursor:pointer
}
.categories button.active{
  background:#111827;
  color:white
}

.container{
  max-width:1200px;
  margin:auto;
  padding:10px
}

.products{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(170px,1fr));
  gap:15px
}

.card{
  background:white;
  border-radius:14px;
  overflow:hidden;
  box-shadow:0 3px 12px rgba(0,0,0,.08)
}

.card img{
  width:100%;
  height:180px;
  object-fit:cover;
  background:#eee
}

.card-content{padding:12px}
.card h3{
  margin:0 0 8px;
  font-size:17px
}
.price{
  color:#e11d48;
  font-size:19px;
  font-weight:bold;
  margin:8px 0
}
.category{
  color:#666;
  font-size:13px
}
.card button{
  width:100%;
  padding:11px;
  border:0;
  border-radius:9px;
  background:#16a34a;
  color:white;
  font-size:15px;
  cursor:pointer
}

.cart{
  position:fixed;
  right:15px;
  bottom:15px;
  background:#e11d48;
  color:white;
  padding:15px 20px;
  border-radius:30px;
  border:0;
  font-size:16px;
  box-shadow:0 4px 15px rgba(0,0,0,.25);
  z-index:20
}

#cartBox{
  display:none;
  position:fixed;
  inset:5%;
  background:white;
  z-index:30;
  border-radius:15px;
  padding:20px;
  overflow:auto;
  box-shadow:0 5px 30px rgba(0,0,0,.4)
}

#cartItems div{
  padding:10px 0;
  border-bottom:1px solid #ddd
}

.close{
  float:right;
  background:#dc2626;
  color:white;
  border:0;
  padding:8px 12px;
  border-radius:8px
}

.order{
  margin-top:20px
}
.order input,.order textarea{
  width:100%;
  padding:12px;
  margin:7px 0;
  border:1px solid #ddd;
  border-radius:8px
}
.order button{
  width:100%;
  padding:13px;
  background:#16a34a;
  color:white;
  border:0;
  border-radius:9px;
  font-size:16px
}

footer{
  text-align:center;
  padding:30px 10px;
  margin-top:30px;
  background:#111827;
  color:white
}
</style>
</head>

<body>

<header>
  <h1>🛒 Mahesh Market</h1>
  <p>ශ්‍රී ලංකාවේ Online Shopping Store</p>
</header>

<div class="search">
  <input id="search" type="text"
  placeholder="🔎 භාණ්ඩයක් සොයන්න..."
  oninput="searchProducts()">
</div>

<div class="container">

<div class="categories" id="categories"></div>

<h2>🛍️ අපගේ භාණ්ඩ</h2>

<div id="products" class="products">
  <p>භාණ්ඩ Loading...</p>
</div>

</div>

<button class="cart" onclick="openCart()">
🛒 Cart (<span id="cartCount">0</span>)
</button>

<div id="cartBox">

<button class="close" onclick="closeCart()">X</button>

<h2>🛒 ඔබගේ Cart එක</h2>

<div id="cartItems"></div>

<h3>මුළු මුදල: Rs. <span id="total">0</span></h3>

<div class="order">

<h3>📦 Order Details</h3>

<input id="customerName" placeholder="ඔබගේ නම">

<input id="customerPhone" placeholder="දුරකථන අංකය">

<input id="customerAddress" placeholder="ලිපිනය">

<textarea id="customerNote"
placeholder="අමතර විස්තර"></textarea>

<button onclick="placeOrder()">
📲 Order එක යවන්න
</button>

</div>

</div>

<footer>
  <p>© 2026 Mahesh Market</p>
  <p>Online Shopping Made Easy 🇱🇰</p>
</footer>

<script>

let products=[];
let cart=[];
let selectedCategory="All";

async function loadProducts(){

try{

const response=await fetch("products.json");

products=await response.json();

createCategories();

displayProducts(products);

}catch(error){

document.getElementById("products").innerHTML=
"<p>Products load වුණේ නැහැ. products.json file එක පරීක්ෂා කරන්න.</p>";

}

}

function createCategories(){

let categories=["All"];

products.forEach(product=>{

if(product.category &&
!categories.includes(product.category)){

categories.push(product.category);

}

});

let html="";

categories.forEach(category=>{

html+=`
<button
class="${category==="All"?"active":""}"
onclick="filterCategory('${category}',this)">
${category}
</button>
`;

});

document.getElementById("categories").innerHTML=html;

}

function filterCategory(category,button){

selectedCategory=category;

document.querySelectorAll(".categories button")
.forEach(btn=>btn.classList.remove("active"));

button.classList.add("active");

let filtered=products;

if(category!=="All"){

filtered=products.filter(p=>
p.category===category
);

}

displayProducts(filtered);

}

function searchProducts(){

let text=document.getElementById("search")
.value.toLowerCase();

let filtered=products.filter(product=>

product.name.toLowerCase().includes(text) ||

product.category.toLowerCase().includes(text)

);

displayProducts(filtered);

}

function displayProducts(list){

let html="";

if(list.length===0){

html="<p>භාණ්ඩ හමු වුණේ නැහැ.</p>";

}else{

list.forEach((product,index)=>{

html+=`

<div class="card">

<img
src="${product.image}"
alt="${product.name}"
onerror="this.src='https://via.placeholder.com/500x400?text=No+Image'">

<div class="card-content">

<h3>${product.name}</h3>

<div class="category">
${product.category}
</div>

<div class="price">
Rs. ${Number(product.price).toLocaleString()}
</div>

<p>${product.description || ""}</p>

<button onclick="addToCart(${index})">
🛒 Cart එකට දාන්න
</button>

</div>

</div>

`;

});

}

document.getElementById("products").innerHTML=html;

}

function addToCart(index){

cart.push(products[index]);

updateCart();

alert("භාණ්ඩය Cart එකට එකතු කළා ✅");

}

function updateCart(){

document.getElementById("cartCount")
.textContent=cart.length;

let html="";
let total=0;

cart.forEach((item,index)=>{

total+=Number(item.price);

html+=`

<div>

<b>${item.name}</b>

<br>

Rs. ${Number(item.price).toLocaleString()}

<button
onclick="removeItem(${index})"
style="float:right;background:#dc2626;color:white;border:0;padding:5px 8px;border-radius:5px">

Remove

</button>

</div>

`;

});

document.getElementById("cartItems").innerHTML=html;

document.getElementById("total")
.textContent=total.toLocaleString();

}

function removeItem(index){

cart.splice(index,1);

updateCart();

}

function openCart(){

document.getElementById("cartBox")
.style.display="block";

updateCart();

}

function closeCart(){

document.getElementById("cartBox")
.style.display="none";

}

function placeOrder(){

let name=document.getElementById("customerName").value;
let phone=document.getElementById("customerPhone").value;
let address=document.getElementById("customerAddress").value;

if(!name || !phone || !address){

alert("කරුණාකර නම, දුරකථන අංකය සහ ලිපිනය ඇතුළත් කරන්න.");

return;

}

if(cart.length===0){

alert("Cart එක හිස්.");

return;

}

let message="🛒 Mahesh Market Order%0A%0A";

message+="නම: "+name+"%0A";
message+="Phone: "+phone+"%0A";
message+="ලිපිනය: "+address+"%0A%0A";

message+="භාණ්ඩ:%0A";

cart.forEach(item=>{

message+="- "+item.name+
" - Rs."+Number(item.price).toLocaleString()+
"%0A";

});

message+="%0Aමුළු මුදල: Rs."+
document.getElementById("total").textContent;

window.open(
"https://wa.me/94751551758?text="+message,
"_blank"
);

}

loadProducts();

</script>

</body>
</html>
